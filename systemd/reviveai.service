[Unit]
Description=ReviveAI private local assistant
After=network.target
ConditionPathExists=/opt/reviveai/models/assistant.gguf

[Service]
Type=simple
User=reviveai
Group=reviveai
ExecStart=/opt/reviveai/bin/llama-server --model /opt/reviveai/models/assistant.gguf --host 127.0.0.1 --port 8080 --ctx-size 2048 --threads -1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/reviveai/models
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
